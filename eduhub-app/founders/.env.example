# Copy this file to .env and fill in your real values.
# Find both of these in the Supabase dashboard: Settings -> API
#
# In production these are NOT read from a file — they're set in Vercel under
# Project Settings -> Environment Variables, with these exact names. Vite
# inlines any VITE_-prefixed variable into the built JavaScript at build
# time, so changing one in Vercel needs a redeploy to take effect.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The "anon public" key (NOT the service_role key — that one must never be
# used in frontend code, or committed anywhere).
#
# The anon key is public by design: it ends up inside the JavaScript bundle
# every visitor downloads, and that's fine — row-level security is what
# actually protects the data, not the secrecy of this key.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only -- for api/application-email-webhook.js (the ImprovMX
# inbound-email webhook). These must NOT get a VITE_ prefix -- that would
# bundle them into the public JavaScript every visitor downloads, the same
# way the anon key above is meant to be public but the service_role key is
# never allowed to be. Set these in Vercel -> Project Settings ->
# Environment Variables only; there's nothing to put in a local .env for
# these since this function isn't something you run with `npm run dev`.
# ---------------------------------------------------------------------------

# Same value as VITE_SUPABASE_URL above.
SUPABASE_URL=

# Supabase dashboard -> Settings -> API -> service_role secret. Bypasses
# every RLS policy -- this is what lets the webhook log an email against a
# family without being signed in as staff. Never put this in a VITE_ var,
# never commit it, never put it anywhere client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Any random string you make up. Put the same value in the ImprovMX
# webhook URL's ?key= so random requests to this endpoint can't insert fake
# case notes.
APPLICATION_EMAIL_WEBHOOK_SECRET=
