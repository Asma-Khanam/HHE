# Copy this file to .env and fill in your real values.
# Find both of these in the Supabase dashboard: Settings -> API
#
# In production these are NOT read from a file — they're set in Vercel under
# Project Settings -> Environment Variables, with these exact names. Vite
# inlines any VITE_-prefixed variable into the built JavaScript at build
# time, so changing one in Vercel needs a redeploy to take effect.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The "anon public" key (NOT the service_role key — that one must never be
# used in frontend code, or committed anywhere).
#
# The anon key is public by design: it ends up inside the JavaScript bundle
# every visitor downloads, and that's fine — row-level security is what
# actually protects the data, not the secrecy of this key.
VITE_SUPABASE_ANON_KEY=
